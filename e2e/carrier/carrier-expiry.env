# Isolated arkade-regtest stack for the carrier-account expiry e2e.
# Block-denominated delays, so the test triggers batch expiry and the sweep by mining.
REGTEST_PROJECT=taxi-carrier-expiry
REGTEST_CONTAINER_PREFIX=taxi-carrier-expiry-
REGTEST_PROFILES=emulator

ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.26
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.26
ARKD_SIGNER_IMAGE=ghcr.io/arkade-os/arkd-signer:v0.9.26
EMULATOR_IMAGE=ghcr.io/arkade-os/emulator:v0.0.10-rc.0

# arkd's own e2e values: all below 512, so all blocks. Automine must stay off,
# or the background miner fires the sweep mid-test.
AUTOMINE_INTERVAL=0
ARKD_VTXO_TREE_EXPIRY=40
ARKD_UNILATERAL_EXIT_DELAY=20
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=20
ARKD_BOARDING_EXIT_DELAY=30
ARKD_CHECKPOINT_EXIT_DELAY=10
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"

MEMPOOL_WEB_PORT=33000
MEMPOOL_API_PORT=38999
BITCOIN_RPC_PORT=38443
BITCOIN_P2P_PORT=38444
BITCOIN_ZMQ_BLOCK_PORT=38332
BITCOIN_ZMQ_TX_PORT=38333
NBXPLORER_PORT=36838
POSTGRES_PORT=36372
FULCRUM_TCP_PORT=30001
FULCRUM_WS_PORT=30003
LND_P2P_PORT=39735
LND_RPC_PORT=30009
ARKD_PORT=37070
ARKD_ADMIN_PORT=37071
ARKD_WALLET_PORT=36060
LND_PEER_P2P_PORT=39736
LND_PEER_RPC_PORT=30010
DELEGATOR_GRPC_PORT=37010
DELEGATOR_API_PORT=37011
DELEGATOR_HTTP_PORT=37012
WALLET_PORT=33003
EXPLORER_PORT=37080
EMULATOR_PORT=37073
COVCLAIMD_HTTP_PORT=37271
EXECUTOR_HTTP_PORT=37280
EXECUTOR_ADMIN_PORT=37281
SOLVER_GRPC_PORT=37090
SOLVER_HTTP_PORT=37091
PRICEFEED_PORT=38088
INTENT_SOLVER_PORT=38787
BUCKET_SYNC_PORT=37100
STRFRY_PORT=37777
LNURL_PORT=39090
