# Isolated arkade-regtest stack for the carrier-account e2e.
# Consumed by: node .reference/arkade-regtest/regtest.mjs start --env e2e/carrier/carrier.env
# Own project, container prefix and port range, so it runs beside a default stack.
REGTEST_PROJECT=taxi-carrier
REGTEST_CONTAINER_PREFIX=taxi-carrier-
REGTEST_PROFILES=emulator

# Latest releases as of 2026-11-19.
ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.26
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.26
ARKD_SIGNER_IMAGE=ghcr.io/arkade-os/arkd-signer:v0.9.26
EMULATOR_IMAGE=ghcr.io/arkade-os/emulator:v0.0.10-rc.0

# Mine explicitly; exact sat amounts are asserted, so intent fees are zero.
AUTOMINE_INTERVAL=0
# Seconds, as the Taxi harness uses: funding must outlive a run, unlike the 17-minute default.
ARKD_VTXO_TREE_EXPIRY=172800
ARKD_UNILATERAL_EXIT_DELAY=86400
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=86400
ARKD_BOARDING_EXIT_DELAY=7776000
ARKD_CHECKPOINT_EXIT_DELAY=86400
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"

MEMPOOL_WEB_PORT=43000
MEMPOOL_API_PORT=48999
BITCOIN_RPC_PORT=48443
BITCOIN_P2P_PORT=48444
BITCOIN_ZMQ_BLOCK_PORT=48332
BITCOIN_ZMQ_TX_PORT=48333
NBXPLORER_PORT=42838
POSTGRES_PORT=49372
FULCRUM_TCP_PORT=40001
FULCRUM_WS_PORT=40003
LND_P2P_PORT=49735
LND_RPC_PORT=40009
ARKD_PORT=47070
ARKD_ADMIN_PORT=47071
ARKD_WALLET_PORT=46060
LND_PEER_P2P_PORT=49736
LND_PEER_RPC_PORT=40010
DELEGATOR_GRPC_PORT=47010
DELEGATOR_API_PORT=47011
DELEGATOR_HTTP_PORT=47012
WALLET_PORT=43003
EXPLORER_PORT=47080
EMULATOR_PORT=47073
COVCLAIMD_HTTP_PORT=47271
EXECUTOR_HTTP_PORT=47280
EXECUTOR_ADMIN_PORT=47281
SOLVER_GRPC_PORT=47090
SOLVER_HTTP_PORT=47091
PRICEFEED_PORT=48088
INTENT_SOLVER_PORT=48787
BUCKET_SYNC_PORT=47100
STRFRY_PORT=47777
LNURL_PORT=49090
