  "source": {
    "entry": "carrier_account.ark",
    "files": {
      "carrier_account.ark": "// A long-lived account: the lender's `loan` sats carry the owner's asset.\n// Every leaf that keeps the account binds out[i] to in[i] for i = the active\n// input, so two coins of one owner can never be folded into a single output.\n// scriptPubKey compares only the witness program, hence the version checks.\npragma arkade ^0.1.0;\n\ncontract CarrierAccount(\n  pubkey ownerKey,\n  pubkey lenderKey,\n  int loan,\n  // The raw BIP68 sequence, pushed as-is.\n  int exitDelay,\n  bytes32 assetTxid,\n  int assetGidx\n) {\n  // Anyone may pay in: the account is recreated in place and only grows.\n  function deposit() {\n    int i = this.activeInputIndex;\n    require(tx.outputs[i].witnessVersion == 1);\n    require(tx.outputs[i].scriptPubKey == tx.inputs[i].scriptPubKey);\n    require(tx.outputs[i].value >= tx.inputs[i].value);\n    int held = 0;\n    if (tx.inputs[i].assets.has(assetTxid, assetGidx)) {\n      held = tx.inputs[i].assets.lookup(assetTxid, assetGidx);\n    }\n    require(tx.outputs[i].assets.lookup(assetTxid, assetGidx) > held);\n  }\n\n  // The owner moves assets out; the loan stays in the recreated account.\n  function send() {\n    int i = this.activeInputIndex;\n    require(tx.outputs[i].witnessVersion == 1);\n    require(tx.outputs[i].scriptPubKey == tx.inputs[i].scriptPubKey);\n    require(tx.outputs[i].value >= loan);\n  }\n\n  function send(signature serverSig, signature ownerSig, signature emulatorSig) tapscript {\n    require(checkMultisig([server, ownerKey, emulator], [serverSig, ownerSig, emulatorSig]));\n  }\n\n  // The owner repays the loan and takes the rest wherever they like.\n  function close() {\n    int i = this.activeInputIndex;\n    require(tx.outputs[i].witnessVersion == 1);\n    require(tx.outputs[i].scriptPubKey == lenderKey);\n    require(tx.outputs[i].value == loan);\n  }\n\n  function close(signature serverSig, signature ownerSig, signature emulatorSig) tapscript {\n    require(checkMultisig([server, ownerKey, emulator], [serverSig, ownerSig, emulatorSig]));\n  }\n\n  // The owner alone, without the Arkade Service or the lender. The lender\n  // forfeits its loan on this path; that is the price of a unilateral exit.\n  function exit(signature ownerSig) tapscript {\n    require(older(exitDelay));\n    require(checkSig(ownerSig, ownerKey));\n  }\n\n  // As in DustCovenant: open to anyone, gated on a register intent.\n  function renew() {\n    require(tx.intent.field(\"type\") == \"register\");\n    require(tx.intent.field(\"onchain_output_indexes\") == \"[]\");\n    require(!tx.intent.has(\"cosigners_public_keys.1\"));\n    require(this.tunnel(this.activeInputIndex - 1));\n  }\n}\n"
    }
  },
